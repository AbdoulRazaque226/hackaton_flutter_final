rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // L'utilisateur courant est l'un des deux acteurs de la demande.
    // Utilisé par les règles du fil de discussion.
    function isParticipant(requestId) {
      let req = get(/databases/$(database)/documents/requests/$(requestId));
      return isSignedIn() && req != null && (
        req.data.clientId == request.auth.uid ||
        req.data.professionalId == request.auth.uid
      );
    }

    function isValidClientReview(requestId) {
      return resource.data.clientId == request.auth.uid
        && resource.data.status == 'terminee'
        && resource.data.get('note', null) == null
        && request.resource.data.note is int
        && request.resource.data.note >= 1
        && request.resource.data.note <= 5
        && (
          request.resource.data.get('commentaire', null) == null
          || (request.resource.data.commentaire is string
            && request.resource.data.commentaire.size() <= 1000)
        );
    }

    function isProfessionalStatusUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && (
          (resource.data.status == 'enAttente'
            && request.resource.data.status in ['acceptee', 'refusee'])
          || (resource.data.status == 'acceptee'
            && request.resource.data.status == 'enCours')
          || (resource.data.status == 'enCours'
            && request.resource.data.status == 'terminee')
      );
    }

    function isValidChatUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastMessageSenderId'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastMessageSenderId == request.auth.uid;
    }

    function isValidReadReceiptUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        request.auth.uid == resource.data.clientId
        && changed.hasOnly(['clientLastReadAt'])
        && request.resource.data.clientLastReadAt is timestamp
      ) || (
        request.auth.uid == resource.data.professionalId
        && changed.hasOnly(['proLastReadAt'])
        && request.resource.data.proLastReadAt is timestamp
      );
    }

    function isValidProfessionalReviewUpdate(proId) {
      let reviewId = request.resource.data.lastReviewRequestId;
      let requestBefore = get(
        /databases/$(database)/documents/requests/$(reviewId)
      );
      let requestAfter = getAfter(
        /databases/$(database)/documents/requests/$(reviewId)
      );
      let oldCount = resource.data.get('nombreEvaluations', 0);
      let storedAverage = resource.data.get('noteMoyenne', null);
      let oldAverage = storedAverage == null ? 0 : storedAverage;
      let storedTotal = resource.data.get('totalNotes', null);
      let oldTotal = storedTotal == null
        ? math.round(oldAverage * oldCount)
        : storedTotal;
      let newCount = request.resource.data.nombreEvaluations;
      let newTotal = request.resource.data.totalNotes;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'noteMoyenne',
          'nombreEvaluations',
          'totalNotes',
          'lastReviewRequestId'
        ])
        && reviewId is string
        && reviewId != resource.data.get('lastReviewRequestId', '')
        && requestBefore.data.clientId == request.auth.uid
        && requestBefore.data.professionalId == proId
        && requestBefore.data.status == 'terminee'
        && requestBefore.data.get('note', null) == null
        && requestAfter.data.note is int
        && requestAfter.data.note >= 1
        && requestAfter.data.note <= 5
        && requestAfter.data.diff(requestBefore.data)
          .affectedKeys()
          .hasOnly(['note', 'commentaire', 'updatedAt'])
        && oldCount is int
        && oldTotal is int
        && newCount == oldCount + 1
        && newTotal == oldTotal + requestAfter.data.note
        && request.resource.data.noteMoyenne == newTotal / newCount;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Un utilisateur modifie son propre compte ; un admin peut modifier
      // n'importe quel compte (ex : bloquer/débloquer).
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    match /professionals/{proId} {
      // Visible par tous les utilisateurs connectés (recherche par métier).
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == proId;
      // Le professionnel ne modifie que disponibilité et position. Les
      // agrégats d'avis ne changent qu'avec la demande terminée correspondante.
      allow update: if isSignedIn() && (
        (request.auth.uid == proId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'displayName',
              'phone',
              'metier',
              'zoneIntervention',
              'country',
              'city',
              'neighborhood',
              'disponible',
              'latitude',
              'longitude'
            ]))
        || isValidProfessionalReviewUpdate(proId)
      );
      allow delete: if false;
    }

    match /requests/{requestId} {
      // Le client et le professionnel concernés voient leur demande ;
      // l'admin voit tout, pour les statistiques globales.
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.professionalId ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      // Le client peut noter une seule demande terminée ; le professionnel
      // peut effectuer les transitions de statut prévues par son parcours.
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.clientId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['note', 'commentaire', 'updatedAt'])
          && isValidClientReview(requestId))
        || (request.auth.uid == resource.data.professionalId
          && isProfessionalStatusUpdate())
        || ((request.auth.uid == resource.data.clientId
              || request.auth.uid == resource.data.professionalId)
            && isValidChatUpdate())
        || ((request.auth.uid == resource.data.clientId
              || request.auth.uid == resource.data.professionalId)
            && isValidReadReceiptUpdate())
      )
      // Les deux acteurs d'une demande ne changent jamais : sans cette garde,
      // un intervenant pourrait se substituer à l'autre en réécrivant le champ
      // correspondant, et gagner l'accès au fil de discussion.
      && request.resource.data.clientId == resource.data.clientId
      && request.resource.data.professionalId == resource.data.professionalId;
      allow delete: if false;

      // Fil de discussion rattaché à la demande : messages immuables,
      // lisibles et écritibles uniquement par ses deux acteurs.
      match /messages/{messageId} {
        allow read: if isParticipant(requestId);

        allow create: if isParticipant(requestId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        // Un message envoyé ne se modifie ni ne se supprime : la lecture est
        // portée par les curseurs de lecture posés sur la demande.
        allow update, delete: if false;
      }
    }
  }
}
