rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // L'utilisateur courant est l'un des deux acteurs de la demande.
    // Utilisé par les règles du fil de discussion.
    function isParticipant(requestId) {
      let req = get(/databases/$(database)/documents/requests/$(requestId));
      return isSignedIn() && req.exists && (
        req.data.clientId == request.auth.uid ||
        req.data.professionalId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Un utilisateur modifie son propre compte ; un admin peut modifier
      // n'importe quel compte (ex : bloquer/débloquer).
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    match /professionals/{proId} {
      // Visible par tous les utilisateurs connectés (recherche par métier).
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == proId;
      // Un professionnel ne modifie que son propre profil (disponibilité, position).
      allow update: if isSignedIn() && request.auth.uid == proId;
      allow delete: if false;
    }

    match /requests/{requestId} {
      // Le client et le professionnel concernés voient leur demande ;
      // l'admin voit tout, pour les statistiques globales.
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.professionalId ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      // Le client peut noter/commenter ; le professionnel peut changer le statut.
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.professionalId
      )
      // Les deux acteurs d'une demande ne changent jamais : sans cette garde,
      // un intervenant pourrait se substituer à l'autre en réécrivant le champ
      // correspondant, et gagner l'accès au fil de discussion.
      && request.resource.data.clientId == resource.data.clientId
      && request.resource.data.professionalId == resource.data.professionalId;
      allow delete: if false;

      // Fil de discussion rattaché à la demande : messages immuables,
      // lisibles et écritibles uniquement par ses deux acteurs.
      match /messages/{messageId} {
        allow read: if isParticipant(requestId);

        allow create: if isParticipant(requestId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        // Un message envoyé ne se modifie ni ne se supprime : la lecture est
        // portée par les curseurs de lecture posés sur la demande.
        allow update, delete: if false;
      }
    }
  }
}
